rules_version = '2';

// Telugu Wordle - Firestore security rules
// Publish these in Firebase Console > Firestore Database > Rules.
// See FIREBASE_SETUP.md for the full setup steps.
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a signed-in user whose UID has a document in /admins.
    // Add admins by hand in the Firebase Console (no one can add themselves).
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin allowlist: users may only check their own entry
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Dictionary words: anyone can read, only admins can change
    match /words/{wordId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Daily puzzles: dailyWords/{YYYY-MM-DD} = { word?, hint?, revealAt, ... }
    match /dailyWords/{date} {
      // Players can read a day's puzzle once that day has started somewhere
      // on Earth (revealAt), so future words can't be peeked at.
      // resource == null lets the game see that nothing is scheduled.
      allow get: if isAdmin()
        || resource == null
        || resource.data.revealAt <= request.time;

      // Only admins can browse the schedule
      allow list: if isAdmin();

      allow create, update: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.revealAt is timestamp
        && (!('word' in request.resource.data) || request.resource.data.word is string)
        && (!('hint' in request.resource.data) || (request.resource.data.hint is string
              && request.resource.data.hint.size() <= 300));

      allow delete: if isAdmin();
    }

    // Reserved for future shared stats
    match /stats/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
